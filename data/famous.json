 {
  "line": "歌声振林樾",
  "author": "袁枚",
  "title": "所见",
  "type": "名句"
 },
 {
  "line": "床前明月光",
  "author": "",
  "title": "",
  "type": "名句"
 },
 {
  "line": "疑是地上霜",
  "author": "",
  "title": "",
  "type": "名句"
 },
 {
  "line": "举头望明月",
  "author": "",
  "title": "",
  "type": "名句"
 },
 {
  "line": "低头思故乡",
  "author": "",
  "title": "",
  "type": "名句"
 },
 {
  "line": "春眠不觉晓",
  "author": "",
  "title": "",
  "type": "名句"
 },
 {
  "line": "处处闻啼鸟",
  "author": "",
  "title": "",
  "type": "名句"
 },
 {
  "line": "夜来风雨声",
  "author": "",
  "title": "",
  "type": "名句"
 },
 {
  "line": "花落知多少",
  "author": "",
  "title": "",
  "type": "名句"
 },
 {
  "line": "白日依山尽",
  "author": "",
  "title": "",
  "type": "名句"
 },
 {
  "line": "黄河入海流",
  "author": "",
  "title": "",
  "type": "名句"
 },
 {
  "line": "欲穷千里目",
  "author": "",
  "title": "",
  "type": "名句"
 },
 {
  "line": "更上一层楼",
  "author": "",
  "title": "",
  "type": "名句"
 },
 {
  "line": "红豆生南国",
  "author": "",
  "title": "",
  "type": "名句"
 },
 {
  "line": "春来发几枝",
  "author": "",
  "title": "",
  "type": "名句"
 },
 {
  "line": "愿君多采撷",
  "author": "",
  "title": "",
  "type": "名句"
 },
 {
  "line": "此物最相思",
  "author": "",
  "title": "",
  "type": "名句"
 },
 {
  "line": "空山不见人",
  "author": "",
  "title": "",
  "type": "名句"
 },
 {
  "line": "但闻人语响",
  "author": "",
  "title": "",
  "type": "名句"
 },
 {
  "line": "返景入深林",
  "author": "",
  "title": "",
  "type": "名句"
 },
 {
  "line": "复照青苔上",
  "author": "",
  "title": "",
  "type": "名句"
 },
 {
  "line": "独在异乡为异客",
  "author": "",
  "title": "",
  "type": "名句"
 },
 {
  "line": "每逢佳节倍思亲",
  "author": "",
  "title": "",
  "type": "名句"
 },
 {
  "line": "桃花潭水深千尺",
  "author": "",
  "title": "",
  "type": "名句"
 },
 {
  "line": "不及汪伦送我情",
  "author": "",
  "title": "",
  "type": "名句"
 },
 {
  "line": "飞流直下三千尺",
  "author": "",
  "title": "",
  "type": "名句"
 },
 {
  "line": "疑是银河落九天",
  "author": "",
  "title": "",
  "type": "名句"
 },
 {
  "line": "两岸猿声啼不住",
  "author": "",
  "title": "",
  "type": "名句"
 },
 {
  "line": "轻舟已过万重山",
  "author": "",
  "title": "",
  "type": "名句"
 },
 {
  "line": "孤帆远影碧空尽",
  "author": "",
  "title": "",
  "type": "名句"
 },
 {
  "line": "唯见长江天际流",
  "author": "",
  "title": "",
  "type": "名句"
 },
 {
  "line": "黄沙百战穿金甲",
  "author": "王昌龄",
  "title": "相和歌辞 从军行 四",
  "type": "名句"
 },
 {
  "line": "不破楼兰终不还",
  "author": "王昌龄",
  "title": "相和歌辞 从军行 四",
  "type": "名句"
 },
 {
  "line": "羌笛何须怨杨柳",
  "author": "王之涣",
  "title": "横吹曲辞 出塞",
  "type": "名句"
 },
 {
  "line": "春风不度玉门关",
  "author": "王之涣",
  "title": "横吹曲辞 出塞",
  "type": "名句"
 },
 {
  "line": "劝君更尽一杯酒",
  "author": "王维",
  "title": "杂曲歌辞 渭城曲",
  "type": "名句"
 },
 {
  "line": "西出阳关无故人",
  "author": "王维",
  "title": "杂曲歌辞 渭城曲",
  "type": "名句"
 },
 {
  "line": "莫愁前路无知己",
  "author": "",
  "title": "",
  "type": "名句"
 },
 {
  "line": "天下谁人不识君",
  "author": "",
  "title": "",
  "type": "名句"
 },
 {
  "line": "正是江南好风景",
  "author": "",
  "title": "",
  "type": "名句"
 },
 {
  "line": "落花时节又逢君",
  "author": "",
  "title": "",
  "type": "名句"
 },
 {
  "line": "沉舟侧畔千帆过",
  "author": "",
  "title": "",
  "type": "名句"
 },
 {
  "line": "病树前头万木春",
  "author": "",
  "title": "",
  "type": "名句"
 },
 {
  "line": "东边日出西边雨",
  "author": "刘禹锡",
  "title": "杂曲歌辞 竹枝 一",
  "type": "名句"
 },
 {
  "line": "道是无晴却有晴",
  "author": "",
  "title": "",
  "type": "名句"
 },
 {
  "line": "身无彩凤双飞翼",
  "author": "",
  "title": "",
  "type": "名句"
 },
 {
  "line": "心有灵犀一点通",
  "author": "",
  "title": "",
  "type": "名句"
 },
 {
  "line": "春蚕到死丝方尽",
  "author": "",
  "title": "",
  "type": "名句"
 },
 {
  "line": "蜡炬成灰泪始干",
  "author": "",
  "title": "",
  "type": "名句"
 },
 {
  "line": "何当共剪西窗烛",
  "author": "",
  "title": "",
  "type": "名句"
 },
 {
  "line": "却话巴山夜雨时",
  "author": "",
  "title": "",
  "type": "名句"
 },
 {
  "line": "小楼一夜听春雨",
  "author": "",
  "title": "",
  "type": "名句"
 },
 {
  "line": "深巷明朝卖杏花",
  "author": "",
  "title": "",
  "type": "名句"
 },
 {
  "line": "沾衣欲湿杏花雨",
  "author": "",
  "title": "",
  "type": "名句"
 },
 {
  "line": "吹面不寒杨柳风",
  "author": "",
  "title": "",
  "type": "名句"
 },
 {
  "line": "春潮带雨晚来急",
  "author": "",
  "title": "",
  "type": "名句"
 },
 {
  "line": "野渡无人舟自横",
  "author": "",
  "title": "",
  "type": "名句"
 },
 {
  "line": "停车坐爱枫林晚",
  "author": "",
  "title": "",
  "type": "名句"
 },
 {
  "line": "霜叶红于二月花",
  "author": "",
  "title": "",
  "type": "名句"
 },
 {
  "line": "商女不知亡国恨",
  "author": "",
  "title": "",
  "type": "名句"
 },
 {
  "line": "隔江犹唱后庭花",
  "author": "",
  "title": "",
  "type": "名句"
 },
 {
  "line": "一骑红尘妃子笑",
  "author": "",
  "title": "",
  "type": "名句"
 },
 {
  "line": "无人知是荔枝来",
  "author": "",
  "title": "",
  "type": "名句"
 },
 {
  "line": "春宵一刻值千金",
  "author": "",
  "title": "",
  "type": "名句"
 },
 {
  "line": "花有清香月有阴",
  "author": "",
  "title": "",
  "type": "名句"
 },
 {
  "line": "枝上柳绵吹又少",
  "author": "",
  "title": "",
  "type": "名句"
 },
 {
  "line": "天涯何处无芳草",
  "author": "",
  "title": "",
  "type": "名句"
 },
 {
  "line": "谁道人生无再少",
  "author": "",
  "title": "",
  "type": "名句"
 },
 {
  "line": "门前流水尚能西",
  "author": "",
  "title": "",
  "type": "名句"
 },
 {
  "line": "大江东去浪淘尽",
  "author": "",
  "title": "",
  "type": "名句"
 },
 {
  "line": "会当凌绝顶",
  "author": "",
  "title": "",
  "type": "名句"
 },
 {
  "line": "一览众山小",
  "author": "",
  "title": "",
  "type": "名句"
 },
 {
  "line": "无边落木萧萧下",
  "author": "",
  "title": "",
  "type": "名句"
 },
 {
  "line": "不尽长江滚滚来",
  "author": "",
  "title": "",
  "type": "名句"
 },
 {
  "line": "安得广厦千万间",
  "author": "",
  "title": "",
  "type": "名句"
 },
 {
  "line": "同是天涯沦落人",
  "author": "",
  "title": "",
  "type": "名句"
 },
 {
  "line": "相逢何必曾相识",
  "author": "",
  "title": "",
  "type": "名句"
 },
 {
  "line": "在天愿作比翼鸟",
  "author": "",
  "title": "",
  "type": "名句"
 },
 {
  "line": "在地愿为连理枝",
  "author": "",
  "title": "",
  "type": "名句"
 },
 {
  "line": "天长地久有时尽",
  "author": "",
  "title": "",
  "type": "名句"
 },
 {
  "line": "此恨绵绵无绝期",
  "author": "",
  "title": "",
  "type": "名句"
 },
 {
  "line": "海上生明月",
  "author": "张九龄",
  "title": "望月怀远",
  "type": "名句"
 },
 {
  "line": "天涯共此时",
  "author": "张九龄",
  "title": "望月怀远",
  "type": "名句"
 },
 {
  "line": "野火烧不尽",
  "author": "",
  "title": "",
  "type": "名句"
 },
 {
  "line": "春风吹又生",
  "author": "",
  "title": "",
  "type": "名句"
 },
 {
  "line": "谁言寸草心",
  "author": "孟郊",
  "title": "杂曲歌辞 游子吟",
  "type": "名句"
 },
 {
  "line": "报得三春晖",
  "author": "孟郊",
  "title": "杂曲歌辞 游子吟",
  "type": "名句"
 },
 {
  "line": "慈母手中线",
  "author": "孟郊",
  "title": "杂曲歌辞 游子吟",
  "type": "名句"
 },
 {
  "line": "游子身上衣",
  "author": "孟郊",
  "title": "杂曲歌辞 游子吟",
  "type": "名句"
 },
 {
  "line": "千山鸟飞绝",
  "author": "",
  "title": "",
  "type": "名句"
 },
 {
  "line": "万径人踪灭",
  "author": "",
  "title": "",
  "type": "名句"
 },
 {
  "line": "孤舟蓑笠翁",
  "author": "",
  "title": "",
  "type": "名句"
 },
 {
  "line": "独钓寒江雪",
  "author": "",
  "title": "",
  "type": "名句"
 },
 {
  "line": "松下问童子",
  "author": "",
  "title": "",
  "type": "名句"
 },
 {
  "line": "言师采药去",
  "author": "",
  "title": "",
  "type": "名句"
 },
 {
  "line": "只在此山中",
  "author": "",
  "title": "",
  "type": "名句"
 },
 {
  "line": "云深不知处",
  "author": "",
  "title": "",
  "type": "名句"
 },
 {
  "line": "锄禾日当午",
  "author": "",
  "title": "",
  "type": "名句"
 },
 {
  "line": "汗滴禾下土",
  "author": "",
  "title": "",
  "type": "名句"
 },
 {
  "line": "谁知盘中餐",
  "author": "",
  "title": "",
  "type": "名句"
 },
 {
  "line": "粒粒皆辛苦",
  "author": "",
  "title": "",
  "type": "名句"
 }
]